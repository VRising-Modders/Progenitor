<Project>
  <!-- A project that sets <ReferenceGame>true</ReferenceGame> compiles against the game's BepInEx and interop assemblies. -->
  <ItemGroup Condition="'$(ReferenceGame)' == 'true'">
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <!-- The exact BepInEx and Il2CppInterop builds the game loads, not the NuGet snapshot: the interop assemblies were
         generated by this Il2CppInterop and reference types the NuGet build does not have. -->
    <Reference Include="$(VRisingGameDir)\BepInEx\core\*.dll" Private="false" />
    <Reference Include="$(VRisingInteropDir)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="ModCheckInterop" BeforeTargets="ResolveAssemblyReferences" Condition="'$(ReferenceGame)' == 'true' and !Exists('$(VRisingInteropDir)\ProjectM.dll')">
    <Error Text="VRisingInteropDir '$(VRisingInteropDir)' does not contain ProjectM.dll. Launch the game once with BepInEx installed, or set VRISING_GAME_DIR / Directory.Build.local.props." />
  </Target>

  <Target Name="ModCheckProgenitor" BeforeTargets="ResolveProjectReferences;CollectPackageReferences">
    <Error Condition="!Exists('$(ProgenitorCoreProject)')"
           Text="No Progenitor checkout found (looked for '$(ProgenitorCoreProject)'). Clone https://github.com/VRising-Modders/Progenitor and set ProgenitorRepo in Directory.Build.local.props, or set the PROGENITOR_REPO environment variable." />
  </Target>
</Project>
