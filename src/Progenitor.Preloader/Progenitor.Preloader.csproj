<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Progenitor.Preloader</AssemblyName>
    <RootNamespace>Progenitor.Preloader</RootNamespace>
    <Product>Progenitor Preloader</Product>
    <Description>
      BepInEx preloader patcher (BepInEx/patchers). Runs before the chainloader opens any plugin
      file and carries out the Mods menu's next-start requests for ordinary BepInEx plugins:
      turn off (rename *.dll to *.dll.old), turn on (rename back) and uninstall (move the folder to
      BepInEx/progenitor-removed). No Core reference, no game types, patches no assembly.
    </Description>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only BepInEx's own preloader surface, from the installed game's BepInEx/core (never NuGet). -->
    <Reference Include="$(VRisingGameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(VRisingGameDir)\BepInEx\core\BepInEx.Preloader.Core.dll" Private="false" />
    <Reference Include="$(VRisingGameDir)\BepInEx\core\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(VRisingGameDir)\BepInEx\core\Mono.Cecil.dll" Private="false" />
  </ItemGroup>
</Project>
