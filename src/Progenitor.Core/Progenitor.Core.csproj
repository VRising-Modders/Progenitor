<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Progenitor</AssemblyName>
    <RootNamespace>Progenitor</RootNamespace>
    <Product>Progenitor</Product>
    <Description>V Rising modding framework. One runtime dependency (BepInEx), original LGPL-2.1-only code, hot reload, debug bridge, prefab registry with client sync, hosted-game launcher. Not a chainloader plugin: Bootstrap loads this DLL from BepInEx/progenitor-core into a collectible ALC.</Description>
    <BepInExPluginGuid>progenitor</BepInExPluginGuid>
    <BepInExPluginName>Progenitor</BepInExPluginName>
    <ReferenceGame>true</ReferenceGame>

    <!--
      NuGet metadata. GeneratePackageOnBuild is false so `dotnet build` does not pack;
      `dotnet pack src/Progenitor.Core/Progenitor.Core.csproj` is the opt-in path.
    -->
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>VRising.Progenitor</PackageId>
    <Authors>Progenitor contributors</Authors>
    <PackageLicenseExpression>LGPL-2.1-only</PackageLicenseExpression>
    <!-- RepositoryUrl and PackageProjectUrl are set when the public repository is decided. -->
  </PropertyGroup>

  <!--
    Game assemblies are compile-time file references from Directory.Build.targets
    (`BepInEx\core\*.dll` and `BepInEx\interop\*.dll`, Private=false). They are not
    PackageReference items, so they do not become PackageDependencies of VRising.Progenitor.
    That is correct — a consumer already has BepInEx + interop from the game install —
    but `dotnet pack` still needs a follow-up before a public push:

      1. Confirm the nupkg dependency group is empty. BepInEx.PluginInfoProps is a
         compile-time PackageReference (Directory.Build.targets); PrivateAssets=all
         below is so it does not leak into the nuspec. Inspect with
         `dotnet pack -nologo` and open the nupkg's .nuspec.
      2. The nupkg has no BepInEx / Unity / ProjectM dependency graph. Consumers must
         still compile against the game's BepInEx\core and BepInEx\interop (see this
         repo's Directory.Build.targets). A README/props package that carries those
         refs is not in 0.1.0.
      3. Packing requires a successful build, which requires the game interop folder
         on the packing machine. There is no CI pack job yet.
      4. RepositoryUrl / PackageProjectUrl are placeholders.
      5. Pack from Release (`-c Release`). Do not publish a Debug nupkg.

    Do not add a PackageReference on BepInEx.* from nuget.org: the interop assemblies
    were generated by the game's Il2CppInterop and reference types the NuGet build lacks.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\Progenitor.RobeSet\garments\*.json" LogicalName="progenitor.guide.%(Filename).json" />
    <EmbeddedResource Include="..\..\samples\Progenitor.RobeSet\assets\icons\*.png" LogicalName="progenitor.guide.icons.%(Filename).png" />
    <!-- The debug buff's HUD icon (Debugging/DebugBuff.IconRelativePath = icons/debug.png). -->
    <EmbeddedResource Include="Debugging\Assets\debug.png" LogicalName="progenitor.content.icons.debug.png" />
    <None Remove="Debugging\Assets\**" />
    <!-- Per-build relative-address maps from tools/addresslib/build.mjs. Logical names stay stable so
         AddressLibrary can find progenitor.addresslib.{side}-{build}.json in the DLL. -->
    <EmbeddedResource Include="..\..\tools\addresslib\client-*.json" Link="addresslib\%(Filename)%(Extension)">
      <LogicalName>progenitor.addresslib.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\tools\addresslib\server-*.json" Link="addresslib\%(Filename)%(Extension)">
      <LogicalName>progenitor.addresslib.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Mods workspace backdrop. Embedded so the image ships inside Core and needs no
         deploy step or reload-folder asset; load it by this logical name. -->
    <EmbeddedResource Include="Ui\Assets\mods-background.png">
      <LogicalName>progenitor.ui.mods-background.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- SETTINGS1 stage 3: the next-start plugin actions. One source file, compiled here (the Mods
         menu writes requests and reads results) and in the preloader patcher (which carries them
         out), so the two cannot disagree about the file format or the safety rules. -->
    <Compile Include="..\Progenitor.Preloader\PluginFileActions.cs" Link="PluginActions\PluginFileActions.cs" />
    <!-- SUPPORT1: the per-session log names the support bundle collects; the preloader writes them. -->
    <Compile Include="..\Progenitor.Preloader\SessionLogFiles.cs" Link="Support\SessionLogFiles.cs" />
  </ItemGroup>

  <ItemDefinitionGroup>
    <PackageReference>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <Reference>
      <Private>false</Private>
      <Pack>false</Pack>
    </Reference>
  </ItemDefinitionGroup>
</Project>
