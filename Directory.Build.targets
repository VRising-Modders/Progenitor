<Project>
  <!-- Git-derived build version (docs/versioning.md), scoped to this project's own inputs. -->
  <PropertyGroup>
    <ProgenitorVersionProjectFile Condition="'$(ProgenitorVersionProjectFile)' == ''">$(MSBuildProjectFullPath)</ProgenitorVersionProjectFile>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)tools/version/ProgenitorVersion.targets" />

  <!-- Projects that opt in with <ReferenceGame>true</ReferenceGame> get BepInEx + every interop assembly. -->
  <ItemGroup Condition="'$(ReferenceGame)' == 'true'">
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <!-- Compile against the exact BepInEx and Il2CppInterop builds the game loads, not the NuGet snapshot:
         the interop assemblies were generated by this Il2CppInterop and reference types (for example
         NativeBoolean) that the NuGet build does not have. -->
    <Reference Include="$(VRisingGameDir)\BepInEx\core\*.dll" Private="false" />
    <Reference Include="$(VRisingInteropDir)\*.dll" Private="false" />
  </ItemGroup>
  <Target Name="ProgenitorCheckInterop" BeforeTargets="ResolveAssemblyReferences" Condition="'$(ReferenceGame)' == 'true' and !Exists('$(VRisingInteropDir)\ProjectM.dll')">
    <Error Text="VRisingInteropDir '$(VRisingInteropDir)' does not contain ProjectM.dll. Launch the game once with BepInEx installed, or set VRISING_INTEROP_DIR / Directory.Build.local.props." />
  </Target>
</Project>
