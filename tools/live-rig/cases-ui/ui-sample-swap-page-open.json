{
  "name": "ui-sample-swap-page-open",
  "world": "connected",
  "summary": "Three client Sample swaps with the Example custom page open. After each swap the owned page is closed, the sidebar lists Sample again, old callbacks are detached (exactly one Try an action log line per click on the new page), connection is retained, and observer/pane counts match the open baseline.",
  "site": "top-tab",
  "notes": [
    "Acceptance procedure — not run. Connected fullscreen HUD. `--side client` and `--dll` pointing at a Sample image (the live file is enough: the swap step copies into the client reload folder and bumps LastWrite so Core still Swaps). Never remove/reinstall. Never a Core swap.",
    "Plugin id progenitor.sample. Custom page title Example. Button label Try an action logs `Sample menu: action handled.`",
    "mods_ui select uses page=custom group=Example. Status fields are after.open / curtain / modsCapture / inputCapture / capture (global alias) / panes / observers / entries (not paneCount). Closed expects use after.modsCapture false, never capture or inputCapture. Record baseline resolution from status (width/height/mode); resolution restore requires mode. open site=top-tab brings up the fullscreen menu and records detail.menuOpenedBy.",
    "The swap step is the client Sample path: LastWrite bump, SAMPLE_SWAP_MATCHERS plus Sample handshake on the client side (no server reconcile wait). It already fails if server users connected is not true or handshake is present and not ok.",
    "After each swap, status after.open=false (the unloading Sample closes its owned page / workspace). Then status.entries must list progenitor.sample once the new generation loads. Reopen, select Example, widget_click Try an action with sinceRecord anchored on that click, log count=1.",
    "Observer/pane counts after reopen must equal the open-state baseline recorded before the first swap. Duplicate native-tab observers or extra panes fail that expect.",
    "Intended finals: workspace closed, curtain/input released, panes 0, observers at the closed baseline, admin restored by the rig, no test resources."
  ],
  "steps": [
    { "kind": "op", "name": "record baseline resolution", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "record": "baselineResolution", "expect": { "ok": true, "action": "status", "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": 0 } },
    { "kind": "op", "name": "record users", "side": "server", "op": "users", "record": "usersStart", "expect": "\"connected\":true" },

    { "kind": "op", "name": "open 1", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "op", "name": "select Example 1", "side": "client", "op": "mods_ui", "args": { "action": "select", "plugin": "progenitor.sample", "page": "custom", "group": "Example" }, "expect": { "ok": true, "action": "select", "after.plugin": "progenitor.sample", "after.page": "custom", "after.pageId": "Example" } },
    { "kind": "op", "name": "widget_read Example 1", "side": "client", "op": "mods_ui", "args": { "action": "widget_read", "pane": "content" }, "expect": { "ok": true, "action": "widget_read" } },
    { "kind": "op", "name": "open baseline counts", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "record": "openBaseline", "expect": { "ok": true, "after.open": true } },
    { "kind": "swap", "name": "client swap 1", "dll": "<path>" },
    { "kind": "op", "name": "page closed after swap 1", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false } },
    { "kind": "op", "name": "connection retained 1", "side": "server", "op": "users", "expect": "\"connected\":true" },
    { "kind": "op", "name": "sidebar lists Sample after swap 1", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": "progenitor\\.sample" },
    { "kind": "op", "name": "reopen 1", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "op", "name": "counts after swap 1", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.observers": "@record:openBaseline.after.observers", "after.panes": "@record:openBaseline.after.panes" } },
    { "kind": "op", "name": "select Example after swap 1", "side": "client", "op": "mods_ui", "args": { "action": "select", "plugin": "progenitor.sample", "page": "custom", "group": "Example" }, "expect": { "ok": true, "after.page": "custom", "after.pageId": "Example" } },
    { "kind": "op", "name": "widget_read after swap 1", "side": "client", "op": "mods_ui", "args": { "action": "widget_read", "pane": "content" }, "expect": { "ok": true, "action": "widget_read" } },
    { "kind": "op", "name": "click Try an action 1", "side": "client", "op": "mods_ui", "args": { "action": "widget_click", "pane": "content", "label": "Try an action" }, "record": "clickAction1", "expect": { "ok": true, "action": "widget_click" } },
    { "kind": "log", "name": "action handled 1", "side": "client", "filter": "Sample menu", "regex": "Sample menu: action handled", "count": 1, "sinceRecord": "clickAction1", "timeoutMs": 5000 },
    { "kind": "op", "name": "connection after click 1", "side": "server", "op": "users", "expect": "\"connected\":true" },
    { "kind": "capture", "name": "cycle 1" },

    { "kind": "op", "name": "open 2", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "op", "name": "select Example 2", "side": "client", "op": "mods_ui", "args": { "action": "select", "plugin": "progenitor.sample", "page": "custom", "group": "Example" }, "expect": { "ok": true, "after.page": "custom", "after.pageId": "Example" } },
    { "kind": "op", "name": "widget_read Example 2", "side": "client", "op": "mods_ui", "args": { "action": "widget_read", "pane": "content" }, "expect": { "ok": true, "action": "widget_read" } },
    { "kind": "swap", "name": "client swap 2", "dll": "<path>" },
    { "kind": "op", "name": "page closed after swap 2", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false } },
    { "kind": "op", "name": "connection retained 2", "side": "server", "op": "users", "expect": "\"connected\":true" },
    { "kind": "op", "name": "sidebar lists Sample after swap 2", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": "progenitor\\.sample" },
    { "kind": "op", "name": "reopen 2", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "op", "name": "counts after swap 2", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.observers": "@record:openBaseline.after.observers", "after.panes": "@record:openBaseline.after.panes" } },
    { "kind": "op", "name": "select Example after swap 2", "side": "client", "op": "mods_ui", "args": { "action": "select", "plugin": "progenitor.sample", "page": "custom", "group": "Example" }, "expect": { "ok": true, "after.page": "custom", "after.pageId": "Example" } },
    { "kind": "op", "name": "widget_read after swap 2", "side": "client", "op": "mods_ui", "args": { "action": "widget_read", "pane": "content" }, "expect": { "ok": true, "action": "widget_read" } },
    { "kind": "op", "name": "click Try an action 2", "side": "client", "op": "mods_ui", "args": { "action": "widget_click", "pane": "content", "label": "Try an action" }, "record": "clickAction2", "expect": { "ok": true, "action": "widget_click" } },
    { "kind": "log", "name": "action handled 2", "side": "client", "filter": "Sample menu", "regex": "Sample menu: action handled", "count": 1, "sinceRecord": "clickAction2", "timeoutMs": 5000 },
    { "kind": "op", "name": "connection after click 2", "side": "server", "op": "users", "expect": "\"connected\":true" },
    { "kind": "capture", "name": "cycle 2" },

    { "kind": "op", "name": "open 3", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "op", "name": "select Example 3", "side": "client", "op": "mods_ui", "args": { "action": "select", "plugin": "progenitor.sample", "page": "custom", "group": "Example" }, "expect": { "ok": true, "after.page": "custom", "after.pageId": "Example" } },
    { "kind": "op", "name": "widget_read Example 3", "side": "client", "op": "mods_ui", "args": { "action": "widget_read", "pane": "content" }, "expect": { "ok": true, "action": "widget_read" } },
    { "kind": "swap", "name": "client swap 3", "dll": "<path>" },
    { "kind": "op", "name": "page closed after swap 3", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false } },
    { "kind": "op", "name": "connection retained 3", "side": "server", "op": "users", "expect": "\"connected\":true" },
    { "kind": "op", "name": "sidebar lists Sample after swap 3", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": "progenitor\\.sample" },
    { "kind": "op", "name": "reopen 3", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "op", "name": "counts after swap 3", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.observers": "@record:openBaseline.after.observers", "after.panes": "@record:openBaseline.after.panes" } },
    { "kind": "op", "name": "select Example after swap 3", "side": "client", "op": "mods_ui", "args": { "action": "select", "plugin": "progenitor.sample", "page": "custom", "group": "Example" }, "expect": { "ok": true, "after.page": "custom", "after.pageId": "Example" } },
    { "kind": "op", "name": "widget_read after swap 3", "side": "client", "op": "mods_ui", "args": { "action": "widget_read", "pane": "content" }, "expect": { "ok": true, "action": "widget_read" } },
    { "kind": "op", "name": "click Try an action 3", "side": "client", "op": "mods_ui", "args": { "action": "widget_click", "pane": "content", "label": "Try an action" }, "record": "clickAction3", "expect": { "ok": true, "action": "widget_click" } },
    { "kind": "log", "name": "action handled 3", "side": "client", "filter": "Sample menu", "regex": "Sample menu: action handled", "count": 1, "sinceRecord": "clickAction3", "timeoutMs": 5000 },
    { "kind": "op", "name": "connection after click 3", "side": "server", "op": "users", "expect": "\"connected\":true" },
    { "kind": "capture", "name": "cycle 3" }
  ],
  "teardown": [
    { "kind": "op", "name": "teardown close", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "op", "name": "teardown restore resolution", "side": "client", "op": "mods_ui", "args": { "action": "resolution", "width": "@record:baselineResolution.after.width", "height": "@record:baselineResolution.after.height", "mode": "@record:baselineResolution.after.mode" } },
    { "kind": "op", "name": "teardown status closed", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes", "after.observers": "@record:baselineResolution.after.observers" } }
  ]
}
