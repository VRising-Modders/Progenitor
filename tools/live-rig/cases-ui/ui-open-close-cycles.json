{
  "name": "ui-open-close-cycles",
  "world": "any",
  "summary": "20 open/status/close/status cycles at `--site` / the world default (`@site`). Each close asserts curtain/modsCapture released and panes equal the recorded baseline. One capture every 5 cycles.",
  "site": "@site",
  "notes": [
    "Acceptance procedure — not run. `--side client`. Open steps use `site` `@site` (`--site main-menu|top-tab|shortcut`; omitted, main-menu with no Client_0, top-tab when connected).",
    "Gate 1: 20 open/navigate/close cycles after a fix is justified. Closed after-state: open=false, curtain=false, modsCapture=false, panes equal the recorded baseline. `close` is the full owned close. Do not expect capture/inputCapture false."
  ],
  "steps": [
    { "kind": "op", "name": "record baseline resolution", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "record": "baselineResolution", "expect": { "ok": true, "action": "status", "after.open": false, "after.curtain": false, "after.modsCapture": false } },
    { "kind": "op", "name": "open 1", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "@site" }, "expect": { "ok": true, "action": "open", "after.open": true, "after.curtain": true } },
    { "kind": "op", "name": "status open 1", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.curtain": true } },
    { "kind": "op", "name": "close 1", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "op", "name": "status closed 1", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "op", "name": "open 2", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "@site" }, "expect": { "ok": true, "action": "open", "after.open": true, "after.curtain": true } },
