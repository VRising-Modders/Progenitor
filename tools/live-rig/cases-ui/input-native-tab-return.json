{
  "name": "input-native-tab-return",
  "world": "connected",
  "summary": "OS-injected click of native Spellbook while Mods is open (closed and released), then again when Spellbook is already selected.",
  "site": "top-tab",
  "notes": [
    "Acceptance procedure — not run. Connected. `--side client`. Evidence: os-injected click of `nativeTab:Spellbook` (live `id` `native-tab` with `label` Spellbook). This is not `mods_ui native_tab` (handler-invocation).",
    "Documented native-tab return: an owned PointerClick observer closes Mods; native handlers stay intact. Same-tab click also closes. After close: after.open=false, after.curtain=false, after.modsCapture=false, panes equal the recorded baseline.",
    "Second click is when Spellbook is already the selected native tab (Mods reopened after the first return). Prerequisite: unlocked workstation, game window can take foreground."
  ],
  "steps": [
    { "kind": "op", "name": "record baseline resolution", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "record": "baselineResolution", "expect": { "ok": true, "action": "status", "after.open": false, "after.curtain": false, "after.modsCapture": false } },
    { "kind": "op", "name": "open", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "after.curtain": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "input", "name": "click Spellbook while open", "action": "click", "target": { "rectOf": "nativeTab:Spellbook" }, "label": "os-injected" },
    { "kind": "op", "name": "status closed after Spellbook", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "op", "name": "reopen", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "after.open": true, "after.curtain": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "input", "name": "click Spellbook already selected", "action": "click", "target": { "rectOf": "nativeTab:Spellbook" }, "label": "os-injected" },
    { "kind": "op", "name": "status closed after same Spellbook", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } }
  ],
  "teardown": [
    { "kind": "op", "name": "teardown close", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "op", "name": "teardown restore resolution", "side": "client", "op": "mods_ui", "args": { "action": "resolution", "width": "@record:baselineResolution.after.width", "height": "@record:baselineResolution.after.height", "mode": "@record:baselineResolution.after.mode" } },
    { "kind": "op", "name": "teardown status closed", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } }
  ]
}
