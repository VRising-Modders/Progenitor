{
  "name": "ui-soak-settings",
  "world": "connected",
  "summary": "Connected: open the top Mods tab, select Sample Server settings, soak 15 minutes with no capture, then close.",
  "site": "top-tab",
  "notes": [
    "Acceptance procedure — not run. Connected fullscreen HUD. `--side client`. No PrintWindow.",
    "Selects Progenitor Sample Server settings (the incident surface) after open. `open site=top-tab` brings up the fullscreen menu itself (`detail.menuOpenedBy`); do not prime with shortcut. `close` is the full owned close, not back-to-overview.",
    "`bridge_status` every 10 s; ping at most every 30 s; socket logs every 15 s. After a ping timeout, soak continues with `bridge_status` + `logs` only.",
    "Perf windows are at most 300 s (`perf.windowSeconds`) with a 2 s gap; `perfWindows[]` lists each start/end. Socket `perf_status` is sampled every soak tick. A recovered stall above 5 s sets `responsivenessFailed`."
  ],
  "steps": [
    { "kind": "op", "name": "record baseline resolution", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "record": "baselineResolution", "expect": { "ok": true, "action": "status", "after.open": false, "after.curtain": false, "after.modsCapture": false } },
    { "kind": "op", "name": "open top-tab", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "top-tab" }, "expect": { "ok": true, "action": "open", "after.open": true, "after.curtain": true, "detail.menuOpenedBy": { "neq": null } } },
    { "kind": "op", "name": "select Sample Server", "side": "client", "op": "mods_ui", "args": { "action": "select", "plugin": "progenitor.sample", "page": "settings", "group": "Server" }, "expect": { "ok": true, "action": "select", "after.open": true, "after.page": "settings", "after.pageId": "Server" } },
    { "kind": "op", "name": "status settings open", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.curtain": true } },
    { "kind": "soak", "name": "soak settings 15min", "side": "client", "minutes": 15, "pingIntervalSeconds": 30, "logsIntervalSeconds": 15, "bridgeStatusIntervalSeconds": 10, "capture": null, "perf": { "windowSeconds": 300, "gapSeconds": 2 }, "stopOnFirstFailure": true },
    { "kind": "op", "name": "close", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } }
  ],
  "teardown": [
    { "kind": "op", "name": "teardown close", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "op", "name": "teardown restore resolution", "side": "client", "op": "mods_ui", "args": { "action": "resolution", "width": "@record:baselineResolution.after.width", "height": "@record:baselineResolution.after.height", "mode": "@record:baselineResolution.after.mode" } },
    { "kind": "op", "name": "teardown status closed", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } }
  ]
}
