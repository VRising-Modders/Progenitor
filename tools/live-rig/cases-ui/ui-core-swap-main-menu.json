{
  "name": "ui-core-swap-main-menu",
  "world": "main-menu",
  "summary": "Three compatible client Core swaps (`coreSwap`) with the main-menu Mods workspace open. Same completion as ui-core-swap-open (generation moved, lastReload.outcome ok, previousAlive false, imageHashes recorded). After each swap: reopen, mods_ui status counts match the open baseline, close. No connection assertions (there is no Client_0 / server users handshake at the main menu).",
  "site": "main-menu",
  "notes": [
    "Acceptance procedure — not run. Main menu, no Client_0. `--side client`. Do not assert server users connected. This is the main-menu variant of ui-core-swap-open. Do not hand-roll `core_reload` / `reload_status` op sequences.",
    "Same `coreSwap` completion: reload_status before, core_reload, poll reload_status until inFlight false, generation moved by 1, lastReload.outcome ok, previousAlive false. Socket refusals are tolerated for maxWaitMs (Dev unloads). Each cycle records generationBefore/After, lastReload.outcome, previousAlive, refusalWindow, and imageHashes.",
    "Open site is main-menu. After each swap: reopen, assert Sample is listed once with observers/panes equal to the open baseline, then close.",
    "No connection assertions. Run this while the client is at the main menu; do not insert it between connected cases without a disconnect.",
    "Intended finals: workspace closed, curtain/input released, panes 0, observers at the closed baseline."
  ],
  "steps": [
    { "kind": "op", "name": "record baseline resolution", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "record": "baselineResolution", "expect": { "ok": true, "action": "status", "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": 0 } },
    { "kind": "op", "name": "open main-menu", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "main-menu" }, "expect": { "ok": true, "after.open": true } },
    { "kind": "op", "name": "open baseline counts", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "record": "openBaseline", "expect": { "ok": true, "after.open": true } },

    { "kind": "coreSwap", "name": "core swap 1", "side": "client", "expectGenerationDelta": 1, "maxWaitMs": 90000, "record": "coreSwap1" },
    { "kind": "op", "name": "reopen after core 1", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "main-menu" }, "expect": { "ok": true, "after.open": true } },
    { "kind": "op", "name": "entry once after core 1", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": "progenitor\\.sample" },
    { "kind": "op", "name": "counts after core 1", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.observers": "@record:openBaseline.after.observers", "after.panes": "@record:openBaseline.after.panes" } },
    { "kind": "op", "name": "close after core 1", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "capture", "name": "core menu cycle 1" },

    { "kind": "op", "name": "open before core 2", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "main-menu" }, "expect": { "ok": true, "after.open": true } },
    { "kind": "coreSwap", "name": "core swap 2", "side": "client", "expectGenerationDelta": 1, "maxWaitMs": 90000, "record": "coreSwap2" },
    { "kind": "op", "name": "reopen after core 2", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "main-menu" }, "expect": { "ok": true, "after.open": true } },
    { "kind": "op", "name": "entry once after core 2", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": "progenitor\\.sample" },
    { "kind": "op", "name": "counts after core 2", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.observers": "@record:openBaseline.after.observers", "after.panes": "@record:openBaseline.after.panes" } },
    { "kind": "op", "name": "close after core 2", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "capture", "name": "core menu cycle 2" },

    { "kind": "op", "name": "open before core 3", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "main-menu" }, "expect": { "ok": true, "after.open": true } },
    { "kind": "coreSwap", "name": "core swap 3", "side": "client", "expectGenerationDelta": 1, "maxWaitMs": 90000, "record": "coreSwap3" },
    { "kind": "op", "name": "reopen after core 3", "side": "client", "op": "mods_ui", "args": { "action": "open", "site": "main-menu" }, "expect": { "ok": true, "after.open": true } },
    { "kind": "op", "name": "entry once after core 3", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": "progenitor\\.sample" },
    { "kind": "op", "name": "counts after core 3", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": true, "after.observers": "@record:openBaseline.after.observers", "after.panes": "@record:openBaseline.after.panes" } },
    { "kind": "op", "name": "close after core 3", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "capture", "name": "core menu cycle 3" }
  ],
  "teardown": [
    { "kind": "op", "name": "teardown close", "side": "client", "op": "mods_ui", "args": { "action": "close" }, "expect": { "ok": true, "after.open": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes" } },
    { "kind": "op", "name": "teardown restore resolution", "side": "client", "op": "mods_ui", "args": { "action": "resolution", "width": "@record:baselineResolution.after.width", "height": "@record:baselineResolution.after.height", "mode": "@record:baselineResolution.after.mode" } },
    { "kind": "op", "name": "teardown status closed", "side": "client", "op": "mods_ui", "args": { "action": "status" }, "expect": { "ok": true, "after.open": false, "after.curtain": false, "after.modsCapture": false, "after.panes": "@record:baselineResolution.after.panes", "after.observers": "@record:baselineResolution.after.observers" } }
  ]
}
