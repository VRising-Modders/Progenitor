<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game-free Edit-and-Continue probe (roadmap M4 item 5, job FENC). No BepInEx, no interop, no
    game reference: keep ReferenceGame off. net6.0 on purpose — that is the CoreCLR the BepInEx
    IL2CPP host actually runs (VRising/dotnet/coreclr.dll is 6.0.7). Deliberately NOT in
    Progenitor.sln: it is a research tool, and its logic is covered by tests/Progenitor.Tests,
    which links EncProbe.cs.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>Progenitor.Enc</RootNamespace>
    <AssemblyName>Progenitor.EncProbe</AssemblyName>
    <IsPackable>false</IsPackable>
    <ReferenceGame>false</ReferenceGame>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Directory.Build.props turns this off for the shipped plugin assemblies; the probe is a
         standalone exe and needs Roslyn beside it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
