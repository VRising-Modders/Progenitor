<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pure-logic tests. Core and Dev reference game assemblies, so this project does not
    ProjectReference them; it compiles the game-free source files directly. CI has no V Rising
    install (see docs/dev-loop.md). Keep ReferenceGame=false. Do not add a game or BepInEx
    reference here.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Progenitor.Tests</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ReferenceGame>false</ReferenceGame>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- PROGENITOR_EXTRA_INSTANCE keeps ExtraInstanceServerAuth's policy half (band, TryAllowEnable,
         argv parsing) compiled here; the Dev csproj sets it for Debug only, so a Release/packaged
         Dev DLL has none of it. Its tests would silently vanish without this. -->
    <DefineConstants>$(DefineConstants);PROGENITOR_TESTS;PROGENITOR_EXTRA_INSTANCE</DefineConstants>
  </PropertyGroup>

