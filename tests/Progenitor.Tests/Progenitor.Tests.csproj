    <Error Condition="@(ReferencePath->AnyHaveMetadataValue('Filename', 'BepInEx.Core'))"
           Text="Progenitor.Tests must not reference BepInEx. Keep ReferenceGame=false and do not ProjectReference Core." />
    <Error Condition="@(ReferencePath->AnyHaveMetadataValue('Filename', 'ProjectM'))"
           Text="Progenitor.Tests must not reference ProjectM. Keep ReferenceGame=false and do not ProjectReference Core." />
    <Error Condition="@(ReferencePath->AnyHaveMetadataValue('Filename', 'Il2CppInterop.Runtime'))"
           Text="Progenitor.Tests must not reference Il2CppInterop. Keep ReferenceGame=false and do not ProjectReference Core." />
    <Error Condition="@(ReferencePath->AnyHaveMetadataValue('Filename', 'HarmonyLib'))"
           Text="Progenitor.Tests must not reference Harmony. Keep ReferenceGame=false and do not ProjectReference Core." />
  </Target>
